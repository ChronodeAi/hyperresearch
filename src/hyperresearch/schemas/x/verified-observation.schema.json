{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/hyperresearch-x-verified-observation.v1.json",
  "title": "Hyperresearch X evidence-backed observation v1",
  "$comment": "Structural validity is not factual verification. Deterministic registered predicates recompute identity, source evidence, coherent joins and actor association. Adapter names, model labels and verified flags never prove truth. Local identity, not publication.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "observation_id", "revision", "domain", "entity", "metric", "quantity", "units", "cap_kind", "observed_at", "as_of", "evaluation_time", "measurement_scope", "source", "verification", "coherence", "association", "event", "correction", "producer"],
  "properties": {
    "schema_version": {"const": 1}, "observation_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, "domain": {"enum": ["crypto", "market", "generic"]},
    "entity": {"$ref": "#/$defs/entity"},
    "metric": {"enum": ["deployment", "total-supply", "circulating-supply", "price", "market-cap", "liquidity", "pool-creation", "swap", "liquidity-add", "liquidity-remove", "reserves", "orderbook-depth", "orderbook-change", "actor-association", "transfer", "chain-identity", "token-decimals"]},
    "quantity": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/decimal"}, {"type": "null"}]}, "units": {"type": ["string", "null"], "minLength": 1}, "cap_kind": {"enum": ["fdv", "circulating-market-cap", null]},
    "observed_at": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/timestamp"}, "as_of": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nullable_timestamp"}, "evaluation_time": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/timestamp"},
    "measurement_scope": {"$ref": "#/$defs/measurement_scope"}, "source": {"$ref": "#/$defs/source"}, "verification": {"$ref": "#/$defs/verification"}, "coherence": {"$ref": "#/$defs/coherence"}, "association": {"$ref": "#/$defs/association"},
    "event": {"anyOf": [{"$ref": "#/$defs/event"}, {"type": "null"}]}, "correction": {"$ref": "#/$defs/correction"}, "producer": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/producer"}
  },
  "allOf": [
    {"if": {"properties": {"metric": {"const": "market-cap"}}}, "then": {"properties": {"cap_kind": {"enum": ["fdv", "circulating-market-cap"]}}}, "else": {"properties": {"cap_kind": {"type": "null"}}}},
    {"if": {"properties": {"verification": {"type": "object", "properties": {"state": {"const": "verified"}}}}}, "then": {"properties": {"as_of": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/timestamp"}, "source": {"type": "object", "properties": {"evidence_refs": {"type": "array", "minItems": 1}}}, "verification": {"type": "object", "properties": {"input_refs": {"type": "array", "minItems": 1}}}}}}
  ],
  "$defs": {
    "entity": {
      "type": "object", "additionalProperties": false, "required": ["namespace", "entity_id", "chain_id", "contract_address", "pool_address", "venue"],
      "properties": {"namespace": {"enum": ["chain-contract", "chain-pool", "venue", "entity"]}, "entity_id": {"type": "string", "minLength": 1}, "chain_id": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+:[A-Za-z0-9_-]+$"}, "contract_address": {"type": ["string", "null"], "minLength": 1}, "pool_address": {"type": ["string", "null"], "minLength": 1}, "venue": {"type": ["string", "null"], "minLength": 1}},
      "allOf": [
        {"if": {"properties": {"namespace": {"const": "chain-contract"}}}, "then": {"properties": {"chain_id": {"type": "string"}, "contract_address": {"type": "string"}}}},
        {"if": {"properties": {"namespace": {"const": "chain-pool"}}}, "then": {"properties": {"chain_id": {"type": "string"}, "pool_address": {"type": "string"}}}},
        {"if": {"properties": {"namespace": {"const": "venue"}}}, "then": {"properties": {"venue": {"type": "string"}}}}
      ],
      "$comment": "Chain plus contract/pool or exact venue identity; ticker/symbol is never a cross-chain join key. Runtime proves normalized entity_id consistency."
    },
    "ref_array": {"type": "array", "items": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}},
    "measurement_scope": {
      "type": "object", "additionalProperties": false, "required": ["scope_id", "aggregation", "chain_id", "pool_refs", "venue", "constituent_refs"],
      "properties": {"scope_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "aggregation": {"enum": ["contract", "pool", "venue", "aggregate"]}, "chain_id": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+:[A-Za-z0-9_-]+$"}, "pool_refs": {"type": "array", "items": {"$ref": "#/$defs/entity"}}, "venue": {"type": ["string", "null"]}, "constituent_refs": {"$ref": "#/$defs/ref_array"}}
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["method", "binding_id", "basis", "evidence_refs", "admission_ref", "endpoint"],
      "properties": {"method": {"enum": ["local-artifact", "evm-json-rpc", "dexscreener-pair"]}, "binding_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "basis": {"type": "string", "minLength": 1}, "evidence_refs": {"$ref": "#/$defs/ref_array"}, "admission_ref": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}, {"type": "null"}]}, "endpoint": {"type": ["string", "null"], "format": "uri", "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"}}
    },
    "verification": {"type": "object", "additionalProperties": false, "required": ["rule_id", "revision", "state", "reasons", "input_refs"], "properties": {"rule_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, "state": {"enum": ["verified", "unverified", "unknown", "invalidated"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "input_refs": {"$ref": "#/$defs/ref_array"}}},
    "coherence": {"type": "object", "additionalProperties": false, "required": ["rule_id", "revision", "state", "max_skew_s", "require_same_block", "as_of_basis", "input_refs", "reasons"], "properties": {"rule_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, "state": {"enum": ["coherent", "incoherent", "unknown"]}, "max_skew_s": {"type": "integer", "minimum": 0, "maximum": 86400}, "require_same_block": {"type": "boolean"}, "as_of_basis": {"type": ["string", "null"]}, "input_refs": {"$ref": "#/$defs/ref_array"}, "reasons": {"type": "array", "items": {"type": "string"}}}},
    "association": {"type": "object", "additionalProperties": false, "required": ["assertion", "observed", "verified", "attribution_refs"], "properties": {"assertion": {"enum": ["present", "absent", "unknown"]}, "observed": {"enum": ["present", "absent", "unknown"]}, "verified": {"enum": ["verified", "unverified", "unknown", "invalidated"]}, "attribution_refs": {"$ref": "#/$defs/ref_array"}}},
    "event": {
      "type": "object", "additionalProperties": false, "required": ["chain_id", "block_number", "block_hash", "transaction_hash", "log_index", "venue_sequence", "kind", "legs", "sender", "recipient", "removed", "actor_id", "evidence_refs"],
      "properties": {
        "chain_id": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+:[A-Za-z0-9_-]+$"}, "block_number": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nullable_count"}, "block_hash": {"type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$"}, "transaction_hash": {"type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$"}, "log_index": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nullable_count"}, "venue_sequence": {"type": ["string", "null"]}, "kind": {"enum": ["swap", "transfer", "deployment", "liquidity-add", "liquidity-remove", "reserves", "snapshot", "reorg", "orderbook-change", "actor-binding"]},
        "legs": {"type": "array", "items": {"$ref": "#/$defs/event_leg"}}, "sender": {"type": ["string", "null"]}, "recipient": {"type": ["string", "null"]}, "removed": {"type": "boolean"}, "actor_id": {"type": ["string", "null"]}, "evidence_refs": {"$ref": "#/$defs/ref_array"}, "block_timestamp": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nullable_timestamp"}
      }
    },
    "event_leg": {"type": "object", "additionalProperties": false, "required": ["contract_address", "decimals", "amount_in_raw", "amount_out_raw", "amount_in", "amount_out"], "properties": {"contract_address": {"type": "string", "minLength": 1}, "decimals": {"type": "integer", "minimum": 0, "maximum": 255}, "amount_in_raw": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)$"}, "amount_out_raw": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)$"}, "amount_in": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nonnegative_decimal"}, "amount_out": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nonnegative_decimal"}}},
    "correction": {"type": "object", "additionalProperties": false, "required": ["state", "supersedes", "retracts", "reason"], "properties": {"state": {"enum": ["original", "corrected", "retracted", "reorg"]}, "supersedes": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}, {"type": "null"}]}, "retracts": {"$ref": "#/$defs/ref_array"}, "reason": {"type": ["string", "null"]}}, "allOf": [{"if": {"properties": {"state": {"const": "original"}}}, "then": {"properties": {"supersedes": {"type": "null"}, "retracts": {"type": "array", "maxItems": 0}}}}, {"if": {"properties": {"state": {"const": "corrected"}}}, "then": {"properties": {"supersedes": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}}}}]},
    "json_value": {"anyOf": [{"type": "string"}, {"type": "number"}, {"type": "boolean"}, {"type": "null"}, {"type": "array", "items": {"$ref": "#/$defs/json_value"}}, {"type": "object", "propertyNames": {"not": {"enum": ["authorization", "cookie", "cookies", "headers", "api_key", "access_token", "private_key"]}}, "additionalProperties": {"$ref": "#/$defs/json_value"}}]},
    "observation_evidence": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "adapter", "binding_id", "endpoint", "entity", "request", "response", "observed_at", "admission_ref"],
      "properties": {"schema_version": {"const": 1}, "adapter": {"enum": ["local-artifact", "evm-json-rpc", "dexscreener-pair"]}, "binding_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "endpoint": {"type": ["string", "null"], "format": "uri", "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"}, "entity": {"$ref": "#/$defs/entity"}, "request": {"$ref": "#/$defs/json_value"}, "response": {"$ref": "#/$defs/json_value"}, "observed_at": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/timestamp"}, "admission_ref": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}, {"type": "null"}]}, "raw_response_ref": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}},
      "$comment": "Inert reproducible raw source envelope. Replay validates admitted binding, pinned read-only RPC requests, ABI responses and constituent closure; response flags cannot authorize or establish verification."
    }
  }
}
