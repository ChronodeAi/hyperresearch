{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/hyperresearch-x-monitor-plan.v1.json",
  "title": "Hyperresearch X monitor plan v1",
  "$comment": "Local governed identity, not publication. Proposal fields are not grants. Digest is bare SHA256 of RFC 8785 JCS UTF8 bytes with only the digest member omitted; plan_digest verifies this invariant. Grant.plan_digest binds that checked digest. Envelope criteria_digest hashes the full profile and analysis_digest hashes the full analysis through the same JCS API; paid envelope grants separately bind exact provider_bounds_ref. Artifact sha256 hashes actual stored bytes. Trust/key/revocation checks are external host policy. Outputs are observational, never trading authority.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plan_id", "revision", "objective", "profile", "queries", "source", "schedule", "limits", "analysis", "authority_refs", "outputs", "digest"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"},
    "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 16384},
    "profile": {"$ref": "#/$defs/profile"},
    "queries": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/query"}},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["backend", "owner", "profile", "allowed_hosts"],
      "properties": {
        "backend": {"const": "opencli"}, "owner": {"type": "string", "minLength": 1}, "profile": {"type": "string", "minLength": 1},
        "allowed_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["x.com", "www.x.com", "twitter.com", "www.twitter.com"]}},
        "allowed_targets": {"$ref": "#/$defs/allowed_targets"}
      }
    },
    "schedule": {
      "type": "object", "additionalProperties": false, "required": ["poll_interval_s", "lookback_s", "windows_s", "lateness_s"],
      "properties": {
        "poll_interval_s": {"type": "integer", "minimum": 1, "maximum": 86400},
        "lookback_s": {"type": "integer", "minimum": 1, "maximum": 31536000},
        "windows_s": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 31536000}},
        "lateness_s": {"type": "integer", "minimum": 0, "maximum": 31536000}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["poll", "session", "analysis"],
      "properties": {"poll": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/source_limits"}, "session": {"$ref": "#/$defs/session_limits"}, "analysis": {"$ref": "#/$defs/analysis_limits"}}
    },
    "analysis": {"$ref": "#/$defs/analysis"},
    "authority_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_path"}},
    "outputs": {
      "type": "object", "additionalProperties": false, "required": ["retain_canonical", "materialize_notes", "formats", "path"],
      "properties": {"retain_canonical": {"const": true}, "materialize_notes": {"type": "boolean"}, "formats": {"type": "array", "uniqueItems": true, "items": {"enum": ["json", "markdown"]}}, "path": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_path"}}
    },
    "digest": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/sha256"}
  },
  "$defs": {
    "version_ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "revision"],
      "properties": {"id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}}
    },
    "query": {
      "type": "object", "additionalProperties": false, "required": ["id", "expression", "revision", "product"],
      "properties": {"id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "expression": {"type": "string", "minLength": 1, "maxLength": 4096}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, "product": {"const": "Latest"}, "compiler_revision": {"const": "x-query-v1"}}
    },
    "profile": {
      "type": "object", "additionalProperties": false, "required": ["id", "revision", "target", "criteria"],
      "properties": {"id": {"enum": ["generic-sentiment", "crypto-discovery", "market-flow"]}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, "target": {"type": "string", "minLength": 1, "maxLength": 4096}, "criteria": {"type": "object"}, "observation_sources": {"type": "array", "items": {"$ref": "#/$defs/observation_binding"}}},
      "allOf": [
        {"if": {"properties": {"id": {"const": "generic-sentiment"}}}, "then": {"properties": {"criteria": {"$ref": "#/$defs/sentiment_criteria"}}}},
        {"if": {"properties": {"id": {"const": "crypto-discovery"}}}, "then": {"properties": {"criteria": {"$ref": "#/$defs/discovery_criteria"}}}},
        {"if": {"properties": {"id": {"const": "market-flow"}}}, "then": {"properties": {"criteria": {"$ref": "#/$defs/flow_criteria"}}}}
      ]
    },
    "sentiment_criteria": {
      "type": "object", "additionalProperties": false, "required": ["labels", "min_classified", "require_context"],
      "properties": {"labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["positive", "negative", "neutral", "mixed", "bullish", "bearish"]}}, "min_classified": {"type": "integer", "minimum": 0, "maximum": 1000000}, "require_context": {"type": "boolean"}}
    },
    "discovery_criteria": {
      "type": "object", "additionalProperties": false, "required": ["chain_ids", "cap", "liquidity", "age", "max_age_s", "max_skew_s", "verification_rule"],
      "properties": {
        "chain_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+:[A-Za-z0-9_-]+$"}},
        "cap": {"type": "object", "additionalProperties": false, "required": ["kind", "currency", "minimum", "maximum"], "properties": {"kind": {"enum": ["fdv", "circulating-market-cap"]}, "currency": {"type": "string", "minLength": 1}, "minimum": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nonnegative_decimal"}, {"type": "null"}]}, "maximum": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nonnegative_decimal"}, {"type": "null"}]}, "supply_basis": {"const": "declared-totalSupply-minus-excluded-balances-v1"}}},
        "liquidity": {"type": "object", "additionalProperties": false, "required": ["measure", "units", "minimum"], "properties": {"measure": {"enum": ["pool-liquidity", "aggregate-liquidity", "orderbook-depth"]}, "units": {"type": "string", "minLength": 1}, "minimum": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nonnegative_decimal"}}},
        "age": {"type": "object", "additionalProperties": false, "required": ["basis", "minimum_s", "maximum_s"], "properties": {"basis": {"enum": ["deployment", "pool-creation"]}, "minimum_s": {"type": "integer", "minimum": 0, "maximum": 315360000}, "maximum_s": {"type": "integer", "minimum": 0, "maximum": 315360000}}},
        "max_age_s": {"type": "integer", "minimum": 0, "maximum": 31536000}, "max_skew_s": {"type": "integer", "minimum": 0, "maximum": 86400}, "verification_rule": {"$ref": "#/$defs/version_ref"}
      }
    },
    "flow_criteria": {
      "type": "object", "additionalProperties": false, "required": ["measurement_scope", "units", "minimum_net_flow", "max_age_s", "max_skew_s", "verification_rule", "require_actor_attribution"],
      "properties": {"measurement_scope": {"type": "string", "minLength": 1}, "units": {"type": "string", "minLength": 1}, "minimum_net_flow": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/decimal"}, {"type": "null"}]}, "max_age_s": {"type": "integer", "minimum": 0, "maximum": 31536000}, "max_skew_s": {"type": "integer", "minimum": 0, "maximum": 86400}, "verification_rule": {"$ref": "#/$defs/version_ref"}, "require_actor_attribution": {"type": "boolean"}}
    },
    "session_limits": {
      "type": "object", "additionalProperties": false, "required": ["max_operations", "max_pages", "max_captures", "max_requests", "max_elapsed_s"],
      "properties": {"max_operations": {"type": "integer", "minimum": 0, "maximum": 1000000}, "max_pages": {"type": "integer", "minimum": 0, "maximum": 10000000}, "max_captures": {"type": "integer", "minimum": 0, "maximum": 100000000}, "max_requests": {"type": "integer", "minimum": 0, "maximum": 100000000}, "max_elapsed_s": {"type": "integer", "minimum": 1, "maximum": 31536000}}
    },
    "analysis_limits": {
      "type": "object", "additionalProperties": false, "required": ["max_requests", "max_tokens", "max_cost_usd", "max_workers", "max_queue", "max_elapsed_s"],
      "properties": {"max_requests": {"type": "integer", "minimum": 0, "maximum": 1000000}, "max_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "max_cost_usd": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nonnegative_decimal", "maxLength": 20}, "max_workers": {"type": "integer", "minimum": 1, "maximum": 1024}, "max_queue": {"type": "integer", "minimum": 0, "maximum": 1000000}, "max_elapsed_s": {"type": "integer", "minimum": 1, "maximum": 86400}, "request_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "request_cost_usd": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nonnegative_decimal", "maxLength": 20}, "provider_bounds_ref": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}}
    },
    "question": {
      "type": "object", "additionalProperties": false, "required": ["id", "revision", "text", "options"],
      "properties": {"id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, "text": {"type": "string", "minLength": 1}, "options": {"type": "array", "minItems": 2, "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "label": {"type": "string", "minLength": 1}}}}}
    },
    "analysis": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "model", "questions", "export_policy", "rubric", "policy", "max_input_chars"],
      "properties": {"enabled": {"type": "boolean"}, "model": {"type": ["string", "null"], "minLength": 1}, "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}}, "export_policy": {"anyOf": [{"$ref": "#/$defs/export_policy"}, {"type": "null"}]}, "rubric": {"$ref": "#/$defs/version_ref"}, "policy": {"$ref": "#/$defs/version_ref"}, "max_input_chars": {"type": "integer", "minimum": 1, "maximum": 10000000}, "guard_policy": {"$ref": "#/$defs/analysis_policy"}},
      "allOf": [{"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"model": {"type": "string"}, "questions": {"type": "array", "minItems": 1}, "export_policy": {"$ref": "#/$defs/export_policy"}}}, "else": {"properties": {"model": {"type": "null"}, "export_policy": {"type": "null"}}}}]
    },
    "export_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "policy_id", "revision", "provider", "endpoint", "region", "retention", "payload_fields", "redactions", "model_ids"],
      "properties": {
        "schema_version": {"const": 1}, "policy_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"},
        "provider": {"type": "string", "minLength": 1}, "endpoint": {"type": "string", "format": "uri", "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"}, "region": {"type": "string", "minLength": 1},
        "retention": {"type": "object", "additionalProperties": false, "required": ["mode", "max_days"], "properties": {"mode": {"enum": ["none", "bounded"]}, "max_days": {"type": "integer", "minimum": 0, "maximum": 3650}}, "allOf": [{"if": {"properties": {"mode": {"const": "none"}}}, "then": {"properties": {"max_days": {"const": 0}}}}]},
        "payload_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["focal_text", "context_text", "author_handle", "post_url", "post_ids", "relationships", "source_spans", "entity_candidates", "query", "question_instructions", "question_options", "profile_target"]}},
        "redactions": {"type": "array", "uniqueItems": true, "items": {"enum": ["author_identity", "urls", "handles", "personal_data"]}},
        "model_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "$comment": "Trusted resolved grant must match actual provider/endpoint/region/retention/models and exported fields. Model spend permission alone does not authorize data export. Unknown settings refuse export."
    },
    "approval_envelope": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "key_id", "payload_b64", "signature_b64"],
      "properties": {"schema_version": {"const": 1}, "key_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "payload_b64": {"type": "string", "minLength": 4, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"}, "signature_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}},
      "$comment": "Standard Ed25519 signature over EXACT decoded payload bytes, not reserialized JSON. Decode with strict base64, validate approval_payload, reject duplicate JSON keys, then verify against the separate trusted host store. No inline public keys."
    },
    "approval_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "purpose", "approval_id", "plan_id", "plan_digest", "plan_revision", "source_owner", "source_profile", "operations", "not_before", "expires_at", "budget_ceilings", "allowed_hosts", "allowed_models", "envelope", "export_policy"],
      "properties": {
        "schema_version": {"const": 1}, "purpose": {"const": "x-research-approval"}, "approval_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "plan_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"},
        "plan_digest": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/sha256"}, {"type": "null"}]}, "plan_revision": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, {"type": "null"}]},
        "source_owner": {"type": "string", "minLength": 1}, "source_profile": {"type": "string", "minLength": 1},
        "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["source.search", "source.post", "source.thread", "source.user-timeline", "source.collection", "model.classify", "observations.read"]}},
        "not_before": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/timestamp"}, "expires_at": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/timestamp"},
        "budget_ceilings": {"$ref": "#/$defs/budget_ceilings"},
        "allowed_hosts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hostname"}},
        "allowed_models": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observation_bindings": {"type": "array", "items": {"$ref": "#/$defs/observation_binding"}},
        "envelope": {"anyOf": [{"$ref": "#/$defs/allowed_envelope"}, {"type": "null"}]}, "export_policy": {"anyOf": [{"$ref": "#/$defs/export_policy"}, {"type": "null"}]}
      },
      "allOf": [
        {"if": {"properties": {"plan_digest": {"type": "null"}}}, "then": {"properties": {"plan_revision": {"type": "null"}, "envelope": {"$ref": "#/$defs/allowed_envelope"}}}, "else": {"properties": {"plan_revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, "envelope": {"type": "null"}}}},
        {"if": {"properties": {"operations": {"type": "array", "contains": {"const": "model.classify"}}}}, "then": {"properties": {"export_policy": {"$ref": "#/$defs/export_policy"}, "allowed_models": {"type": "array", "minItems": 1}}, "allOf": [{"if": {"properties": {"plan_digest": {"type": "null"}}}, "then": {"properties": {"envelope": {"type": "object", "required": ["provider_bounds_ref"], "properties": {"provider_bounds_ref": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}}}}}}]}},
        {"if": {"properties": {"operations": {"type": "array", "contains": {"const": "observations.read"}}}}, "then": {"required": ["observation_bindings"], "properties": {"observation_bindings": {"type": "array", "minItems": 1}, "budget_ceilings": {"type": "object", "required": ["observation_requests", "observation_timeout_s"], "properties": {"observation_requests": {"type": "integer", "minimum": 1}, "observation_timeout_s": {"type": "integer", "minimum": 1}}}}}}
      ]
    },
    "budget_ceilings": {
      "type": "object", "additionalProperties": false, "required": ["source_requests", "source_pages", "total_captures", "operation_timeout_s", "session_duration_s", "model_requests", "model_tokens", "model_cost_usd"],
      "properties": {"source_requests": {"type": "integer", "minimum": 0, "maximum": 100000000}, "source_pages": {"type": "integer", "minimum": 0, "maximum": 10000000}, "total_captures": {"type": "integer", "minimum": 0, "maximum": 100000000}, "operation_timeout_s": {"type": "integer", "minimum": 1, "maximum": 86400}, "session_duration_s": {"type": "integer", "minimum": 1, "maximum": 31536000}, "model_requests": {"type": "integer", "minimum": 0, "maximum": 1000000}, "model_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000}, "model_cost_usd": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nonnegative_decimal", "maxLength": 20}, "observation_requests": {"type": "integer", "minimum": 0, "maximum": 1000000, "default": 0}, "observation_timeout_s": {"type": "integer", "minimum": 0, "maximum": 86400, "default": 0}}
    },
    "allowed_envelope": {
      "type": "object", "additionalProperties": false, "required": ["query_expressions", "profile_ids", "profile_revisions", "products", "criteria_digest", "analysis_digest", "allow_related_context"],
      "properties": {"query_expressions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}, "profile_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["generic-sentiment", "crypto-discovery", "market-flow"]}}, "profile_revisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}}, "products": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"const": "Latest"}}, "criteria_digest": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/sha256"}, "analysis_digest": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/sha256"}, "allow_related_context": {"type": "boolean"}, "allowed_targets": {"$ref": "#/$defs/allowed_targets"}, "provider_bounds_ref": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}}
    },
    "trust_store": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "purpose", "keys", "revoked_approval_ids", "grant_root"],
      "properties": {"schema_version": {"const": 1}, "purpose": {"const": "x-research-trust-store"}, "keys": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=(?![\\s\\S])"}}, "revoked_approval_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}}, "admitted_snapshot_digests": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/sha256"}}, "grant_root": {"type": "string", "minLength": 1, "pattern": "^/[^\\u0000]*(?![\\s\\S])"}},
      "$comment": "Host configuration, never proposal state. Runtime requires regular non-symlink root-owned store and safe ancestors, not group/other writable. Keys are raw32-byte Ed25519 public keys only; no signing material. admitted_snapshot_digests authenticates exact externally curated snapshot bytes/input closures, not arbitrary copied grants or imported verification flags."
    },
    "x_config": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean", "default": false}, "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "default": ["opencli"]},
        "trust_store": {"type": "string", "default": ""}, "plan_ref": {"type": "string", "default": ""}, "approval_ref": {"type": "string", "default": ""}, "source_owner": {"type": "string", "default": ""}, "source_profile": {"type": "string", "default": ""},
        "poll_interval_s": {"type": "integer", "minimum": 1, "maximum": 86400, "default": 30}, "lookback_s": {"type": "integer", "minimum": 1, "maximum": 31536000, "default": 600}, "operation_timeout_s": {"type": "integer", "minimum": 1, "maximum": 86400, "default": 180},
        "max_primary": {"type": "integer", "minimum": 0, "maximum": 1000000, "default": 100}, "max_total_captures": {"type": "integer", "minimum": 0, "maximum": 1000000, "default": 200}, "max_pages": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 10}, "max_source_requests": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 20},
        "session_duration_s": {"type": "integer", "minimum": 1, "maximum": 31536000, "default": 1800}, "max_session_source_requests": {"type": "integer", "minimum": 0, "maximum": 100000000, "default": 300},
        "analysis_enabled": {"type": "boolean", "default": false}, "model": {"type": "string", "default": ""}, "analysis_workers": {"type": "integer", "minimum": 1, "maximum": 1024, "default": 4}, "max_model_requests": {"type": "integer", "minimum": 0, "maximum": 1000000, "default": 0}, "max_model_tokens": {"type": "integer", "minimum": 0, "maximum": 1000000000, "default": 0}, "max_model_cost_usd": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nonnegative_decimal", "maxLength": 20, "default": "0"},
        "max_observation_requests": {"type": "integer", "minimum": 0, "maximum": 1000000, "default": 0}, "observation_timeout_s": {"type": "integer", "minimum": 1, "maximum": 86400, "default": 30}
      },
      "$comment": "Nested application configuration. Defaults are declarative; runtime settings apply them. Command is argv, never a shell plan. Trust store is separately controlled host input."
    },
    "analysis_policy": {
      "type": "object", "additionalProperties": false, "required": ["id", "revision", "allow_negative_veto", "required_post_ids", "counterevidence_post_ids", "question_roles"],
      "properties": {"id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, "allow_negative_veto": {"type": "boolean"}, "required_post_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/post_id"}}, "counterevidence_post_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/post_id"}}, "question_roles": {"type": "object", "propertyNames": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "additionalProperties": {"enum": ["relevance", "sentiment", "source-type", "narrative", "candidate"]}}}
    },
    "observation_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "binding_id", "endpoint", "allowed_hosts", "chain_id", "contract_addresses", "pool_addresses", "venue", "block_number", "block_hash", "deployment_tx_hash", "token0", "token1", "artifact_refs", "verification_rule", "coherence", "rpc_methods", "call_selectors"],
      "properties": {
        "id": {"enum": ["local-artifact", "evm-json-rpc", "dexscreener-pair"]}, "binding_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"},
        "endpoint": {"type": ["string", "null"], "format": "uri", "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"},
        "allowed_hosts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hostname"}},
        "chain_id": {"type": ["string", "null"], "pattern": "^[a-z0-9-]+:[A-Za-z0-9_-]+$"}, "contract_addresses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "pool_addresses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "venue": {"type": ["string", "null"]},
        "block_number": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, {"type": "null"}]}, "block_hash": {"type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$"}, "deployment_tx_hash": {"type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$"}, "pool_creation_tx_hash": {"type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$"},
        "block_policy": {"enum": ["pinned", "rolling-latest", "rolling-finalized"]},
        "token0": {"anyOf": [{"$ref": "#/$defs/token_binding"}, {"type": "null"}]}, "token1": {"anyOf": [{"$ref": "#/$defs/token_binding"}, {"type": "null"}]},
        "artifact_refs": {"type": "array", "items": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}}, "verification_rule": {"$ref": "#/$defs/version_ref"},
        "coherence": {"type": "object", "additionalProperties": false, "required": ["rule_id", "revision", "max_skew_s", "require_same_block"], "properties": {"rule_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, "max_skew_s": {"type": "integer", "minimum": 0, "maximum": 86400}, "require_same_block": {"type": "boolean"}}},
        "rpc_methods": {"type": "array", "uniqueItems": true, "items": {"enum": ["eth_chainId", "eth_getBlockByNumber", "eth_getBlockByHash", "eth_getTransactionReceipt", "eth_getCode", "eth_call", "eth_getLogs"]}},
        "call_selectors": {"type": "array", "uniqueItems": true, "items": {"enum": ["0x0dfe1681", "0xd21220a7", "0x313ce567", "0x18160ddd", "0x0902f1ac", "0xc45a0155", "0xe6a43905", "0x70a08231"]}},
        "factory_address": {"type": ["string", "null"]}, "pool_code_sha256": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/sha256"}, {"type": "null"}]}, "factory_code_sha256": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/sha256"}, {"type": "null"}]}, "excluded_supply_addresses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "receipt_read_scope": {"enum": ["declared-only", "admitted-pool-events"]},
        "header_read_scope": {"enum": ["pinned-only", "admitted-receipt-ancestors"]},
        "entity_scope": {"enum": ["explicit", "captured-leads"]},
        "actor_keys": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["key_id", "issuer", "public_key_b64"], "properties": {"key_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "issuer": {"type": "string", "minLength": 1}, "public_key_b64": {"type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$"}}}}
      },
      "allOf": [
        {"if": {"properties": {"id": {"const": "local-artifact"}}}, "then": {"properties": {"endpoint": {"type": "null"}, "allowed_hosts": {"type": "array", "maxItems": 0}, "rpc_methods": {"type": "array", "maxItems": 0}, "call_selectors": {"type": "array", "maxItems": 0}}}, "else": {"properties": {"endpoint": {"type": "string"}, "allowed_hosts": {"type": "array", "minItems": 1}, "chain_id": {"type": "string"}}}},
        {"if": {"required": ["block_policy"], "properties": {"block_policy": {"enum": ["rolling-latest", "rolling-finalized"]}}}, "then": {"properties": {"block_number": {"type": "null"}, "block_hash": {"type": "null"}}}}
      ],
      "$comment": "Only registered read-only adapters. Signed observation_bindings match the entire requested binding, including code pins/entity/method/selector/coherence scope. Missing block_policy means pinned; rolling uses exact getBlockByNumber latest/finalized tag proof to obtain the actual header, then EIP1898 state reads. By-number reorg checks cover only prior independently origin-admitted sampled headers, never arbitrary history/ranges or dynamic binding fields. Missing receipt_read_scope/header_read_scope/entity_scope means declared-only/pinned-only/explicit. captured-leads admits deterministic attributed source-capture spans under the frozen chain/endpoint/method binding, never plugins, URL templates or rewritten signed contract lists. Adapter names and evidence flags are not proof."
    },
    "token_binding": {"type": "object", "additionalProperties": false, "required": ["address", "decimals"], "properties": {"address": {"type": "string", "minLength": 1}, "decimals": {"type": "integer", "minimum": 0, "maximum": 255}}},
    "allowed_targets": {
      "type": "object", "additionalProperties": false,
      "properties": {"post": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/public_target"}}, "thread": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/public_target"}}, "user-timeline": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/public_target"}}, "collection": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/public_target"}}},
      "$comment": "Exact targets, not patterns or wildcard authority. Missing operation key forbids that non-search operation."
    },
    "public_target": {"type": "string", "pattern": "^(?:[1-9][0-9]{0,24}|@?[A-Za-z0-9_]{1,15}|https://(?:www\\.)?(?:x\\.com|twitter\\.com)/(?:[A-Za-z0-9_]{1,15}(?:/status/[1-9][0-9]{0,24})?|i/web/status/[1-9][0-9]{0,24}))$"},
    "provider_billing_bounds": {
