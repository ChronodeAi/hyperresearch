      "properties": {"schema_version": {"const": 1}, "id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, "provider": {"type": "string", "minLength": 1}, "endpoint": {"type": "string", "format": "uri", "pattern": "^https://[^/@?#]+(?:/[^?#]*)?$"}, "model_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "max_request_bytes": {"type": "integer", "minimum": 1, "maximum": 100000000}, "max_questions": {"type": "integer", "minimum": 1, "maximum": 10000}, "max_options_per_question": {"type": "integer", "minimum": 2, "maximum": 10000}, "max_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000000}, "max_cost_usd": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nonnegative_decimal", "maxLength": 20}, "expires_at": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/timestamp"}, "attestation_refs": {"type": "array", "items": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}}},
      "$comment": "Conservative operator/provider-attested billing ceilings, cryptographically bound through the signed plan and exact provider_bounds_ref. Not an SDK max-token/cost setting; absent/expired/unattested bounds refuse dispatch."
    },
