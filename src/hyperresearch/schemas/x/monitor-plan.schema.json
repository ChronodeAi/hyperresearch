      "type": "object", "additionalProperties": false, "required": ["reserved", "actual", "unknown"],
      "properties": {"reserved": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "actual": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "unknown": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}}
