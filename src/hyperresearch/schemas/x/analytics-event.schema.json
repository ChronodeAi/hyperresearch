{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiwg.io/schemas/hyperresearch-x-analytics-event.v1.json",
  "title": "Hyperresearch X observational analytics event v1",
  "$comment": "Immutable logical window revisions preserve correction/retraction lineage. Replay uses explicit evaluation_time and frozen input/frontier closure, never callback order or wall clock. Unknown/outage records remain in denominators. No trading authority. Local identity, not publication.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "logical_id", "revision", "supersedes", "retraction", "retracted_inputs", "monitor_id", "profile", "plan_ref", "input_refs", "frontiers", "evaluation_time", "window", "metrics", "denominators", "coverage", "freshness", "provisional", "disposition", "reasons", "producer"],
  "properties": {
    "schema_version": {"const": 1}, "logical_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, "supersedes": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}, {"type": "null"}]}, "retraction": {"type": "boolean"}, "retracted_inputs": {"$ref": "#/$defs/ref_array"},
    "monitor_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "profile": {"$ref": "https://aiwg.io/schemas/hyperresearch-x-monitor-plan.v1.json#/$defs/profile"}, "plan_ref": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/plan_ref"},
    "input_refs": {"type": "object", "additionalProperties": false, "required": ["capture_refs", "receipt_refs", "annotation_refs", "observation_refs"], "properties": {"capture_refs": {"$ref": "#/$defs/ref_array"}, "receipt_refs": {"$ref": "#/$defs/ref_array"}, "annotation_refs": {"$ref": "#/$defs/ref_array"}, "observation_refs": {"$ref": "#/$defs/ref_array"}}},
    "frontiers": {"type": "object", "additionalProperties": false, "required": ["source", "analysis", "observations", "corrections"], "properties": {"source": {"$ref": "#/$defs/ref_array"}, "analysis": {"$ref": "#/$defs/ref_array"}, "observations": {"$ref": "#/$defs/ref_array"}, "corrections": {"$ref": "#/$defs/ref_array"}}},
    "evaluation_time": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/timestamp"},
    "window": {"type": "object", "additionalProperties": false, "required": ["start", "end", "size_s"], "properties": {"start": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/timestamp"}, "end": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/timestamp"}, "size_s": {"type": "integer", "minimum": 1, "maximum": 31536000}}},
    "metrics": {"$ref": "#/$defs/metrics"}, "denominators": {"$ref": "#/$defs/denominators"},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["state", "receipt_refs", "reasons"], "properties": {"state": {"enum": ["complete", "partial", "unknown"]}, "receipt_refs": {"$ref": "#/$defs/ref_array"}, "reasons": {"type": "array", "items": {"type": "string"}}}},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["state", "max_age_s", "oldest_as_of"], "properties": {"state": {"enum": ["fresh", "stale", "unknown"]}, "max_age_s": {"type": "integer", "minimum": 0, "maximum": 31536000}, "oldest_as_of": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nullable_timestamp"}}},
    "event_role": {"enum": ["window", "lead"]},
    "subject": {"anyOf": [{"$ref": "https://aiwg.io/schemas/hyperresearch-x-verified-observation.v1.json#/$defs/entity"}, {"type": "null"}]},
    "policy": {"anyOf": [{"$ref": "https://aiwg.io/schemas/hyperresearch-x-monitor-plan.v1.json#/$defs/analysis_policy"}, {"type": "null"}]},
    "authority_snapshot_ref": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}, {"type": "null"}]},
    "provisional": {"type": "boolean"}, "disposition": {"enum": ["observed", "needs-verification", "matches-criteria", "does-not-match", "retracted", "insufficient-evidence"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "producer": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/producer"}
  },
  "allOf": [
    {"if": {"properties": {"revision": {"type": "integer", "minimum": 2}}}, "then": {"properties": {"supersedes": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}}}},
    {"if": {"properties": {"retraction": {"const": true}}}, "then": {"properties": {"disposition": {"const": "retracted"}, "retracted_inputs": {"type": "array", "minItems": 1}}}},
    {"if": {"properties": {"coverage": {"type": "object", "properties": {"state": {"enum": ["partial", "unknown"]}}}}}, "then": {"properties": {"provisional": {"const": true}}}},
    {"if": {"required": ["event_role"], "properties": {"event_role": {"const": "lead"}}}, "then": {"required": ["subject"], "properties": {"subject": {"$ref": "https://aiwg.io/schemas/hyperresearch-x-verified-observation.v1.json#/$defs/entity"}}}}
  ],
  "$defs": {
    "ref_array": {"type": "array", "items": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/artifact_ref"}},
    "metrics": {
      "type": "object", "additionalProperties": false, "required": ["post_count", "unique_authors", "event_type_counts", "sentiment_counts", "leads", "flows"],
      "properties": {
        "post_count": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "unique_authors": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"},
        "event_type_counts": {"type": "object", "additionalProperties": false, "required": ["original", "repost", "quote", "reply", "unknown"], "properties": {"original": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "repost": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "quote": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "reply": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "unknown": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}}},
        "sentiment_counts": {"type": "object", "additionalProperties": false, "required": ["positive", "negative", "neutral", "mixed", "bullish", "bearish", "unknown"], "properties": {"positive": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "negative": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "neutral": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "mixed": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "bullish": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "bearish": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "unknown": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}}},
        "leads": {"type": "array", "items": {"$ref": "#/$defs/lead"}}, "flows": {"type": "array", "items": {"$ref": "#/$defs/flow"}},
        "target_counts": {"type": "object", "additionalProperties": false, "required": ["matched", "unmatched", "unknown"], "properties": {"matched": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "unmatched": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "unknown": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}}},
        "unique_original_authors": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"},
        "unknown_authors": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"},
        "duplicate_occurrences": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"},
        "unknown_event_time": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"},
        "unknown_roles": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"},
        "source_gap_count": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"},
        "source_error_count": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"},
        "stale_annotations": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"},
        "annotation_status_counts": {"type": "object", "propertyNames": {"enum": ["available", "abstained", "insufficient-context", "unavailable", "failed", "deferred"]}, "additionalProperties": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}},
        "observation_status_counts": {"type": "object", "additionalProperties": false, "required": ["total", "verified", "unknown", "retracted"], "properties": {"total": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "verified": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "unknown": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "retracted": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}}, "$comment": "Runtime verified+unknown partitions effective window observations; retracted is a subset of unknown with visible correction/reorg proof. Record flags are not data-origin authority."},
        "sentiment_by_event_type": {"type": "object", "propertyNames": {"enum": ["original", "repost", "quote", "reply", "unknown"]}, "additionalProperties": {"$ref": "#/$defs/metrics/properties/sentiment_counts"}},
        "narratives": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["label", "count", "annotation_refs"], "properties": {"label": {"type": "string"}, "count": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "annotation_refs": {"$ref": "#/$defs/ref_array"}}}}
      }
    },
    "lead": {"type": "object", "additionalProperties": false, "required": ["entity", "disposition", "reasons", "capture_refs", "annotation_refs", "observation_refs"], "properties": {"entity": {"$ref": "https://aiwg.io/schemas/hyperresearch-x-verified-observation.v1.json#/$defs/entity"}, "disposition": {"enum": ["observed", "needs-verification", "matches-criteria", "does-not-match"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "capture_refs": {"$ref": "#/$defs/ref_array"}, "annotation_refs": {"$ref": "#/$defs/ref_array"}, "observation_refs": {"$ref": "#/$defs/ref_array"}, "source_spans": {"type": "array", "items": {"$ref": "https://aiwg.io/schemas/hyperresearch-x-analysis-annotation.v1.json#/$defs/source_span"}}, "facts": {"anyOf": [{"$ref": "#/$defs/lead_facts"}, {"type": "null"}]}}},
    "flow": {"type": "object", "additionalProperties": false, "required": ["entity", "quantity", "units", "observation_refs", "actor_state", "reasons"], "properties": {"entity": {"$ref": "https://aiwg.io/schemas/hyperresearch-x-verified-observation.v1.json#/$defs/entity"}, "quantity": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/decimal"}, {"type": "null"}]}, "units": {"type": "string", "minLength": 1}, "observation_refs": {"$ref": "#/$defs/ref_array"}, "actor_state": {"enum": ["verified", "unverified", "unknown", "invalidated"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "kind": {"enum": ["swap-net", "liquidity-net", "reserve-change", "depth-change"]}, "measurement_scope": {"$ref": "https://aiwg.io/schemas/hyperresearch-x-verified-observation.v1.json#/$defs/measurement_scope"}}},
    "lead_facts": {
      "type": "object", "additionalProperties": false, "required": ["cap", "liquidity", "age", "snapshot"],
      "properties": {
        "cap": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["quantity", "kind", "currency", "basis", "as_of", "observation_refs"], "properties": {"quantity": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nonnegative_decimal"}, {"type": "null"}]}, "kind": {"enum": ["fdv", "circulating-market-cap", null]}, "currency": {"type": ["string", "null"]}, "basis": {"type": ["string", "null"]}, "as_of": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nullable_timestamp"}, "observation_refs": {"$ref": "#/$defs/ref_array"}}}]},
        "liquidity": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["quantity", "measure", "units", "basis", "as_of", "observation_refs"], "properties": {"quantity": {"anyOf": [{"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nonnegative_decimal"}, {"type": "null"}]}, "measure": {"enum": ["pool-liquidity", "aggregate-liquidity", "orderbook-depth", null]}, "units": {"type": ["string", "null"]}, "basis": {"type": ["string", "null"]}, "as_of": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nullable_timestamp"}, "observation_refs": {"$ref": "#/$defs/ref_array"}}}]},
        "age": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["seconds", "basis", "as_of", "observation_refs"], "properties": {"seconds": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nullable_count"}, "basis": {"enum": ["deployment", "pool-creation", null]}, "as_of": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nullable_timestamp"}, "observation_refs": {"$ref": "#/$defs/ref_array"}}}]},
        "snapshot": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["rule_id", "revision", "common_as_of", "block_hash", "max_skew_s", "measurement_scope"], "properties": {"rule_id": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/identifier"}, "revision": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/revision"}, "common_as_of": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/nullable_timestamp"}, "block_hash": {"type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$"}, "max_skew_s": {"type": "integer", "minimum": 0, "maximum": 86400}, "measurement_scope": {"$ref": "https://aiwg.io/schemas/hyperresearch-x-verified-observation.v1.json#/$defs/measurement_scope"}}}]}
      }
    },
    "denominators": {"type": "object", "additionalProperties": false, "required": ["total", "covered", "unknown", "errors", "abstained", "insufficient_context", "unavailable", "deferred"], "properties": {"total": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "covered": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "unknown": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "errors": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "abstained": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "insufficient_context": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "unavailable": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}, "deferred": {"$ref": "https://aiwg.io/schemas/opencli-x-source-receipt.v1.json#/$defs/count"}}}
  }
}
