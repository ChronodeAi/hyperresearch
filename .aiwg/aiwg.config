{
  "$schema": "https://aiwg.io/schemas/aiwg.config.v1.json",
  "version": "1",
  "delivery": {
    "mode": "pr-required",
    "default_branch": "main",
    "rationale": "Owner 2026-11-18: fork of jordan-gibbs/hyperresearch. Changes reach main through pull requests; local work lands on the chronode branch."
  },
  "remotes": {
    "primary": "origin",
    "issue_tracker": "origin",
    "ci": "origin",
    "tracker_actor": {
      "login": "ChronodeAi",
      "via": "gh"
    }
  }
}
